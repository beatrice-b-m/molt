{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Molt",
  "version": "0.1.0",
  "identifier": "dev.molt.notebook",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:fe",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Molt",
        "width": 680,
        "height": 720,
        "resizable": true,
        "visible": true,
        "decorations": true,
        "transparent": true,
        "skipTaskbar": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": [
      "resources/kernel_server.py"
    ]
  }
}
